    "NSCalendarsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightwell reads the size of calendar data to show what uses space. It never reads your events."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightwell reads the size of contacts data to show what uses space. It never reads your contacts."
          }
        }
      }
    },
    "NSDesktopFolderUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightwell reads the names and sizes of items on your Desktop to show what uses space. It never opens their contents."
          }
        }
      }
    },
    "NSDocumentsFolderUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightwell reads the names and sizes of items in Documents to show what uses space. It never opens their contents."
          }
        }
      }
    },
    "NSDownloadsFolderUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightwell reads the names and sizes of items in Downloads to show what uses space. It never opens their contents."
          }
        }
      }
    },
    "NSFileProviderDomainUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightwell reads the names and sizes of items in cloud storage folders to show what uses space. It never opens their contents."
          }
        }
      }
    },
    "NSNetworkVolumesUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightwell reads the names and sizes of items on network disks to show what uses space. It never opens their contents."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightwell reads the size of your photo library to show what uses space. It never looks at your photos."
          }
        }
      }
    },
    "NSRemindersUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightwell reads the size of reminders data to show what uses space. It never reads your reminders."
          }
