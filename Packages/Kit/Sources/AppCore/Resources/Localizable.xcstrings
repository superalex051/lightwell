{
  "sourceLanguage": "en",
  "strings": {
    "An API key is set in the environment, so usage would be billed to that key instead of your Claude login.": {
      "comment": "Refusal reason: ANTHROPIC_API_KEY environment variable",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An API key is set in the environment, so usage would be billed to that key instead of your Claude login."
          }
        }
      }
    },
    "Claude Code could not be started. Check Settings, then try again.": {
      "comment": "Assistant error when the claude process could not be launched",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code could not be started. Check Settings, then try again."
          }
        }
      }
    },
    "Claude Code has an API key helper in its settings, so usage would be billed to that key instead of your Claude login.": {
      "comment": "Refusal reason: apiKeyHelper configured in Claude Code settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code has an API key helper in its settings, so usage would be billed to that key instead of your Claude login."
          }
        }
      }
    },
    "Claude Code is not signed in. Open Terminal, run claude and sign in, then try again.": {
      "comment": "Assistant error when the CLI reports an authentication problem",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code is not signed in. Open Terminal, run claude and sign in, then try again."
          }
        }
      }
    },
    "Claude Code is signed in with a stored API key, so usage would be billed to that key instead of your Claude login.": {
      "comment": "Refusal reason: the CLI uses a stored API key",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code is signed in with a stored API key, so usage would be billed to that key instead of your Claude login."
          }
        }
      }
    },
    "Claude Code reports another API key source (%@), so usage would be billed to it instead of your Claude login.": {
      "comment": "Refusal reason: an unknown key source, shown verbatim",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code reports another API key source (%@), so usage would be billed to it instead of your Claude login."
          }
        }
      }
    },
    "Claude Code stopped unexpectedly. Try again to pick up the conversation where it left off.": {
      "comment": "Assistant error when the claude process exits with an error",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code stopped unexpectedly. Try again to pick up the conversation where it left off."
          }
        }
      }
    },
    "Claude could not finish this reply.": {
      "comment": "Assistant error when a turn ended with an unspecified error",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude could not finish this reply."
          }
        }
      }
    },
    "Claude is busy, retrying (%lld of %lld).": {
      "comment": "Assistant notice while the API is overloaded and the CLI retries",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude is busy, retrying (%lld of %lld)."
          }
        }
      }
    },
    "Earlier messages of this conversation are not shown here, but Claude still remembers them.": {
      "comment": "Assistant notice when reopening a saved conversation",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earlier messages of this conversation are not shown here, but Claude still remembers them."
          }
        }
      }
    },
    "Nothing was sent. Sign in with your Claude account (run claude in Terminal, then /login), or turn off Block API keys in Settings.": {
      "comment": "Refusal card advice",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was sent. Sign in with your Claude account (run claude in Terminal, then /login), or turn off Block API keys in Settings."
          }
        }
      }
    },
    "Please continue.": {
      "comment": "Message sent to Claude when the user presses Continue after the step limit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please continue."
          }
        }
      }
    },
    "Scan a disk or folder first, so the assistant has something to look at.": {
      "comment": "Assistant notice when no scan exists yet",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a disk or folder first, so the assistant has something to look at."
          }
        }
      }
    },
    "Stopped after %lld steps. Choose Continue to let Claude keep going.": {
      "comment": "Assistant notice when the per-message step limit was reached",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Stopped after %lld step. Choose Continue to let Claude keep going."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Stopped after %lld steps. Choose Continue to let Claude keep going."
                }
              }
            }
          }
        }
      }
    },
    "Stopped.": {
      "comment": "Assistant notice after the user pressed Stop",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped."
          }
        }
      }
    },
    "Stopped: Claude Code would bill an API key": {
      "comment": "Title of the card shown when a session is refused because an API key is in use",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped: Claude Code would bill an API key"
          }
        }
      }
    },
    "The disk tools did not connect, so Claude cannot see the scan. Try again; the details can help with a bug report.": {
      "comment": "Assistant error when the MCP helper failed to connect",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The disk tools did not connect, so Claude cannot see the scan. Try again; the details can help with a bug report."
          }
        }
      }
    },
    "This conversation reached its usage guard. Choose Continue to allow more, or start a new conversation. The guard can be changed in Settings.": {
      "comment": "Assistant notice when the per-thread token guard is reached",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversation reached its usage guard. Choose Continue to allow more, or start a new conversation. The guard can be changed in Settings."
          }
        }
      }
    },
    "Your Claude usage limit is reached for now. It resets later; you can also check your plan in Claude.": {
      "comment": "Assistant error when the account hit its usage limit",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Claude usage limit is reached for now. It resets later; you can also check your plan in Claude."
          }
        }
      }
    }
  },
  "version": "1.0"
}
